# Secrets des Edge Functions — à saisir dans Supabase : Project Settings → Edge Functions → Secrets
# (ou : supabase secrets set --env-file supabase/functions/.env).
# SUPABASE_URL, SUPABASE_ANON_KEY et SUPABASE_SERVICE_ROLE_KEY sont fournis automatiquement.
# Sans ces secrets, l'app tourne en mode simulé (plans "mock", paiements désactivés, SMS dans les logs).

# --- Environnement ---
APP_ENV=production                     # "production" interdit le SMS simulé
APP_URL=https://app.startandshift.com   # retour après paiement : {APP_URL}/paiement/retour?payment_id=…
BACKOFFICE_URL=https://admin.startandshift.com  # lien des invitations e-mail de l'équipe
ALLOWED_ORIGIN=*                       # CORS : mettre l'URL de l'app web en production
IP_HASH_SALT=change-moi-chaine-aleatoire  # sel pour anonymiser les IP (limite de plans par jour)

# --- IA (génération du plan) ---
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5-5    # défaut
# ANTHROPIC_EFFORT=low                 # low (défaut, moins cher) | medium | high
# AI_MOCK=true                         # force le plan simulé (aucun appel payant)

# --- Paiement FedaPay ---
FEDAPAY_ENV=sandbox                    # sandbox | live
FEDAPAY_SECRET_KEY=sk_sandbox_...
FEDAPAY_WEBHOOK_SECRET=wh_sandbox_...
# FEDAPAY_MODE_FLOOZ=moov_tg           # défauts FedaPay pour le Togo
# FEDAPAY_MODE_TMONEY=togocel
# PAYMENTS_MOCK=true                   # dev uniquement : paiement accepté sans prestataire (ignoré si FEDAPAY_ENV=live)

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_TOKEN=EAAG...                 # jeton permanent d'un utilisateur système
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# WHATSAPP_OTP_TEMPLATE=sas_code_connexion
# WHATSAPP_TEMPLATE_LANG=fr

# --- Connexion par téléphone (hook "Send SMS" de Supabase Auth) ---
SEND_SMS_HOOK_SECRET=v1,whsec_...      # généré par Supabase en créant le hook
# SMS_PROVIDER=mock                    # fournisseur SMS de secours, à brancher plus tard
